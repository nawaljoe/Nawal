{
  "name": "semarak-subuh-2026",
  "version": "1.0.0",
  "description": "Program Semarak Subuh Johor 2026 \u2014 3 Amalan Yang Tidak Terhitung Banyaknya (9:16 re-edit, Remotion + HyperFrames)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/effects": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "studio": "remotion studio src/index.ts",
    "still": "remotion still SemarakSubuh2026 out/still.png --frame=280",
    "render": "remotion render SemarakSubuh2026 out/raw.mp4 --codec=h264 --crf=16 --audio-bitrate=320k --jpeg-quality=95 --pixel-format=yuv420p",
    "master": "bash pipeline/master.sh",
    "timeline": "python3 pipeline/build_timeline.py",
    "scenes": "python3 pipeline/assemble_scenes.py pipeline/story.json"
  },
  "allowScripts": {
    "esbuild": false
  }
