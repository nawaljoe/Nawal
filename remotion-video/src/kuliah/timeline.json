  "quotes": [
    {
      "seg": "m7b",
      "at": 5.6,
      "dur": 9.4,
      "arabic": "كُلُّ عَمَلِ ابْنِ آدَمَ لَهُ إِلَّا الصِّيَامَ، فَإِنَّهُ لِي وَأَنَا أَجْزِي بِهِ",
      "text": "Setiap amalan anak Adam untuk dirinya, kecuali puasa. Sesungguhnya puasa itu untuk-Ku, dan Akulah yang membalasnya.",
      "source": "Hadis Qudsi · Riwayat al-Bukhari & Muslim"
    },
    {
      "seg": "m3a",
      "at": 1.9,
      "dur": 7.1,
      "arabic": null,
      "text": "Dapat nikmat, bersyukur — baik.\nDitimpa musibah, bersabar — pun baik.",
      "source": null
    },
    {
      "seg": "m6a",
      "at": 7.96,
      "dur": 12.2,
      "arabic": "فَمَنْ عَفَا وَأَصْلَحَ فَأَجْرُهُ عَلَى اللَّهِ",
      "text": "Sesiapa yang memaafkan dan berbuat baik, maka pahalanya ditanggung oleh Allah.",
      "source": "Surah asy-Syura · ayat 40"
    }
  ],
  "hook": {
